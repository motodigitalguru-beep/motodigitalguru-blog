# Giscus — GitHub Discussions as comment layer.
# Run https://giscus.app to generate these for your repo, then drop the values here.
# Until set, the comment block on posts is hidden.

PUBLIC_GISCUS_REPO=motodigitalguru-beep/blog-comments
PUBLIC_GISCUS_REPO_ID=
PUBLIC_GISCUS_CATEGORY=Comments
PUBLIC_GISCUS_CATEGORY_ID=
