---
import type { CollectionEntry } from "astro:content";

interface Props {
  post: CollectionEntry<"posts">;
}

const { post } = Astro.props;
const { title, description, publishedAt, tags } = post.data;

const dateFmt = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "short",
  day: "numeric",
}).format(publishedAt);
---

<article class="group">
  <a
    href={`/writing/${post.slug}`}
    class="block py-8 border-b border-zinc-900 transition hover:border-zinc-800"
  >
    <div class="flex items-baseline justify-between gap-4 mb-2">
      <time
        class="font-mono text-xs text-zinc-500 shrink-0"
        datetime={publishedAt.toISOString()}
      >
        {dateFmt}
      </time>
      {tags.length > 0 && (
        <div class="flex flex-wrap gap-2 justify-end">
          {tags.slice(0, 3).map((tag) => (
            <span class="font-mono text-[10px] uppercase tracking-widest text-zinc-600">
              {tag}
            </span>
          ))}
        </div>
      )}
    </div>
    <h2 class="text-xl sm:text-2xl font-semibold tracking-tight text-zinc-100 group-hover:text-accent transition leading-snug mb-2">
      {title}
    </h2>
    <p class="text-zinc-400 text-sm leading-relaxed">{description}</p>
  </a>
</article>
