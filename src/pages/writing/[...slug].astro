---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import Giscus from "../../components/Giscus.astro";

export async function getStaticPaths() {
  const posts = await getCollection("posts", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await post.render();
const { title, description, publishedAt, updatedAt, tags } = post.data;

const dateFmt = new Intl.DateTimeFormat("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
}).format(publishedAt);
const updatedFmt = updatedAt
  ? new Intl.DateTimeFormat("en-US", {
      year: "numeric",
      month: "long",
      day: "numeric",
    }).format(updatedAt)
  : null;
---

<BaseLayout
  title={`${title} — motodigitalguru`}
  description={description}
  publishedAt={publishedAt}
>
  <Header current="home" />

  <article class="mx-auto max-w-3xl px-6 py-16 sm:py-24">
    <a
      href="/"
      class="inline-flex items-center gap-2 mb-12 font-mono text-sm text-zinc-500 hover:text-zinc-300 transition"
    >
      ← writing
    </a>

    <header class="mb-12">
      <div class="flex items-baseline gap-4 mb-4 flex-wrap">
        <time
          class="font-mono text-xs text-zinc-500"
          datetime={publishedAt.toISOString()}
        >
          {dateFmt}
        </time>
        {tags.length > 0 && (
          <div class="flex flex-wrap gap-3">
            {tags.map((tag) => (
              <span class="font-mono text-[10px] uppercase tracking-widest text-zinc-600">
                {tag}
              </span>
            ))}
          </div>
        )}
      </div>
      <h1 class="text-3xl sm:text-5xl font-semibold tracking-tight text-zinc-100 leading-[1.1]">
        {title}
      </h1>
      <p class="mt-6 text-lg text-zinc-400 leading-relaxed">{description}</p>
    </header>

    <div class="prose prose-invert prose-zinc max-w-none prose-headings:font-semibold prose-headings:tracking-tight prose-pre:rounded-xl prose-pre:border prose-pre:border-zinc-800 prose-code:text-zinc-200 prose-code:before:content-[''] prose-code:after:content-['']">
      <Content />
    </div>

    {updatedFmt && (
      <p class="mt-12 text-xs font-mono text-zinc-600">
        Updated {updatedFmt}
      </p>
    )}

    <Giscus />
  </article>

  <Footer />
</BaseLayout>
